# Public DNS name for the HTTPS signaling endpoint.
SIGNALING_DOMAIN=signal.example.com

# Public DNS name of the TURN server.
TURN_PUBLIC_HOST=turn.example.com
TURN_REALM=turn.example.com
TURN_PORT=3478
TURN_TLS_PORT=5349

# Generate with: openssl rand -hex 32
# This value MUST match static-auth-secret in turnserver.conf.
TURN_SHARED_SECRET=replace-with-a-random-secret

# Optional STUN URI. Point this at the coturn listener or another STUN service.
STUN_URL=stun:turn.example.com:3478
