{
  "name": "p2p-file-sharing-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron and React desktop shell for the Java P2P file sharing core",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.17.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "pnpm run typecheck && pnpm run build:electron && pnpm run build:renderer",
    "test": "pnpm run build:electron && node --test tests/*.test.mjs",
    "package:linux": "pnpm run build && electron-builder --linux dir"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.tanh.p2pfilesharing",
    "productName": "P2P File Sharing",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/install/file_sharing/lib",
        "to": "backend/lib"
      }
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Network"
    }
  },
  "packageManager": "pnpm@12.17.0"
}
